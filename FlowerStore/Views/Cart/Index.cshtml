@model List<CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    var total = (decimal)(ViewData["Total"] ?? 0m);
}

@section Styles {
    <style>
        .cart-container {
            max-width: 850px;
            margin: 40px auto;
            padding: 35px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .cart-container h1 {
            color: #d63384;
        }

        .cart-item {
            padding: 15px;
            margin: 10px 0;
            background-color: #fff0f6;
            border: 1px solid #f5c2d7;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-total {
            color: #d63384;
            margin-top: 25px;
        }

        .cart-list {
            list-style: none;
            padding: 0;
        }

        .remove-btn {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
}

<!-- Shopping Cart (stored in the Session) -->
<main class="cart-container">
    <h1>🛒 Your Shopping Cart</h1>
    <p>Here are the flowers you selected.</p>

    @if (TempData["Message"] != null)
{
    <div style="max-width: 600px; margin: 20px auto; padding: 12px; background-color: #fff0f6; border: 1px solid #f5c2d7; border-radius: 8px; color: #d63384; text-align: center; font-weight: bold;">
        @TempData["Message"]
    </div>
}

    <ul class="cart-list">
        @if (Model.Count == 0)
        {
            <li>Your cart is empty.</li>
        }
        else
        {
            foreach (var item in Model)
            {
                <li class="cart-item">
                    <span>
                        <strong>@item.Name</strong> —
                        @item.Price.ToString("0.##") SAR × @item.Quantity
                        = <strong>@item.Total.ToString("0.##") SAR</strong>
                    </span>

                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="remove-btn">✕ Remove</button>
                    </form>
                </li>
            }
        }
    </ul>

    <h2 class="cart-total">
        Total: @total.ToString("0.##") SAR
    </h2>

    @if (Model.Count > 0)
    {
        <form asp-action="Clear" method="post" id="clearCartForm" style="display: inline;">
            <button class="btn" type="submit">Clear Cart</button>
        </form>
    }

    <p>
        <a asp-controller="Products" asp-action="Index" class="btn">
            Continue Shopping 🌸
        </a>
    </p>
</main>

<!-- Image Mapping -->
<div style="text-align:center; margin:30px 0;">
    <h3>Click the image to visit About Us</h3>
    <img src="~/flower.jpg"
         alt="Flower Store"
         width="250"
         usemap="#workmap"
         style="border-radius:8px; box-shadow:0 4px 8px rgba(0,0,0,0.1);">
    <map name="workmap">
        <area shape="rect"
              coords="0,0,250,250"
              alt="About Us"
              href="@Url.Action("About", "Home")">
    </map>
</div>
