@model Order
@{
    ViewData["Title"] = "Checkout";
    var cart = ViewData["Cart"] as List<CartItem> ?? new List<CartItem>();
    var total = (decimal)(ViewData["Total"] ?? 0m);
}

@section Styles {
    <style>
        .checkout-container {
            max-width: 900px;
            margin: 40px auto;
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .checkout-box {
            flex: 1;
            min-width: 300px;
            padding: 30px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .checkout-box h2 {
            color: #d63384;
            text-align: center;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-family: inherit;
        }

        .field-error {
            color: #dc3545;
            font-size: 13px;
        }

        .summary-table {
            width: 100%;
        }

        .summary-total {
            color: #d63384;
            text-align: right;
        }
    </style>
}

<div class="checkout-container">

    <!-- Order summary (from the Session cart) -->
    <section class="checkout-box">
        <h2>🧾 Order Summary</h2>

        <table class="summary-table">
            <thead>
                <tr>
                    <th>Flower</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cart)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>× @item.Quantity</td>
                        <td>@item.Total.ToString("0.##") SAR</td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="summary-total">Total: @total.ToString("0.##") SAR</h3>

        <p style="text-align: center;">
            <a asp-controller="Cart" asp-action="Index" style="color: #d63384;">← Back to Cart</a>
        </p>
    </section>

    <!-- Delivery form (sent to OrdersController.Checkout POST) -->
    <section class="checkout-box">
        <h2>🚚 Delivery Details</h2>

        <form asp-action="Checkout" method="post" id="checkoutForm">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="form-group">
                <label asp-for="CustomerName"></label>
                <input asp-for="CustomerName" placeholder="Who will receive the flowers?" />
                <span asp-validation-for="CustomerName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" placeholder="05XXXXXXXX" maxlength="10" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" rows="3" placeholder="City, district, street, house number"></textarea>
                <span asp-validation-for="Address" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DeliveryDate"></label>
                <input asp-for="DeliveryDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DeliveryDate" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" rows="2" maxlength="200" placeholder="e.g. Happy Birthday! 💐"></textarea>
                <span id="notesCounter" style="color: #888; font-size: 12px;">0 / 200</span>
                <span asp-validation-for="Notes" class="field-error"></span>
            </div>

            <button type="submit" class="btn" style="width: 100%;">Confirm Order 💐</button>
        </form>
    </section>
</div>

@section Scripts {
    <!-- Embedded JavaScript: client-side checks before sending the order -->
    <script>
        const checkoutForm = document.getElementById("checkoutForm");
        const notesBox = document.getElementById("Notes");
        const notesCounter = document.getElementById("notesCounter");

        // Live character counter for the gift message
        function updateCounter() {
            notesCounter.textContent = notesBox.value.length + " / 200";
        }
        notesBox.addEventListener("input", updateCounter);
        updateCounter();

        checkoutForm.addEventListener("submit", function (event) {
            const phone = document.getElementById("Phone").value.trim();
            const dateValue = document.getElementById("DeliveryDate").value;
            const today = new Date().toISOString().split("T")[0];

            if (!/^05\d{8}$/.test(phone)) {
                alert("Phone must be 10 digits and start with 05.");
                event.preventDefault();
            }
            else if (dateValue === "" || dateValue < today) {
                alert("Please choose a delivery date from today onwards.");
                event.preventDefault();
            }
        });
    </script>
}
