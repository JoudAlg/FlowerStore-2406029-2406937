@model List<Product>
@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"] as string;
    var category = ViewData["Category"] as string;
}

@section Styles {
    <style>
        .products-container {
            padding: 40px 20px;
            text-align: center;
        }

        .products-container h1 {
            color: #d63384;
        }

        .product-card {
            width: 250px;
        }

        .product-card p {
            line-height: 1.6;
        }

        .product-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 8px;
        }

        .product-placeholder {
            font-size: 60px;
            height: 160px;
            line-height: 160px;
        }

        .search-form {
            margin: 25px auto;
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .category-filter {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin: 10px auto 25px;
        }

        .category-btn {
            padding: 8px 18px;
            border: 2px solid #d63384;
            border-radius: 20px;
            color: #d63384;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .category-btn:hover,
        .category-btn.active {
            background-color: #d63384;
            color: white;
        }

        .category-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            background-color: #fff0f6;
            color: #d63384;
            font-size: 13px;
            font-weight: bold;
            margin-top: 8px;
        }

        .search-form input {
            width: 300px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
    </style>
}

<!-- Products Section -->
<main class="products-container">
    <h1>Our Flower Collection</h1>
    <p>
        Explore our beautiful flowers and gifts
        for every special occasion.
    </p>

    <!-- SEARCH form (sends ?search=... to the controller) -->
    <form asp-action="Index" method="get" class="search-form">
        <!-- keep the chosen category while searching -->
        <input type="hidden" name="category" value="@category" />
        <input type="text" name="search" value="@search" placeholder="Search flowers, e.g. rose" />
        <button type="submit" class="btn">Search 🔍</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" asp-route-category="@category" class="btn">Clear Search</a>
        }
    </form>

    <!-- CATEGORY filter buttons (they keep the current search) -->
    <nav class="category-filter">
        <a asp-action="Index" asp-route-search="@search"
           class="category-btn @(category == null ? "active" : "")">All</a>

        @foreach (var cat in Product.Categories)
        {
            <a asp-action="Index" asp-route-category="@cat" asp-route-search="@search"
               class="category-btn @(category == cat ? "active" : "")">@cat</a>
        }
    </nav>

    @if (TempData["Message"] != null)
{
    <div style="max-width: 600px; margin: 20px auto; padding: 12px; background-color: #fff0f6; border: 1px solid #f5c2d7; border-radius: 8px; color: #d63384; text-align: center; font-weight: bold;">
        @TempData["Message"]
    </div>
}

    @if (!string.IsNullOrEmpty(search))
    {
        <p>
            Found <strong>@Model.Count</strong> result(s) for "<strong>@search</strong>"
            @if (category != null)
            {
                <span>in <strong>@category</strong></span>
            }
        </p>
    }

    @if (Model.Count == 0)
    {
        <p>No products found. 🌱</p>
    }

    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-card"
                 data-name="@product.Name"
                 data-price="@product.Price">

                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" alt="@product.Name" />
                }
                else
                {
                    <div class="product-placeholder">💐</div>
                }

                <span class="category-badge">@product.Category</span>
                <h2>@product.Name</h2>
                <p>@product.Description</p>
                <h3>@product.Price.ToString("0.##") SAR</h3>

                <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button class="btn add-to-cart" type="submit">
                        Add to Cart
                    </button>
                </form>
            </div>
        }
    </div>

    <p>
        <a asp-controller="Cart" asp-action="Index" class="btn">
            View Shopping Cart 🛒
        </a>
        <a asp-action="Manage" class="btn">
            Manage Products ⚙️
        </a>
    </p>
</main>

<!-- Image Mapping -->
<div style="text-align:center; margin:30px 0;">
    <h3>Click the image to visit About Us</h3>
    <img src="~/images/flower.jpg"
         alt="Flower Store"
         width="250"
         usemap="#workmap"
         style="border-radius:8px; box-shadow:0 4px 8px rgba(0,0,0,0.1);">
    <map name="workmap">
        <area shape="rect"
              coords="0,0,250,250"
              alt="About Us"
              href="@Url.Action("About", "Home")">
    </map>
</div>
