@model Product

<!-- Shared form fields used by Create and Edit -->
<div asp-validation-summary="ModelOnly" class="field-error"></div>

<div class="form-group">
    <label asp-for="Name"></label>
    <input asp-for="Name" placeholder="e.g. Red Rose Bouquet" />
    <span asp-validation-for="Name" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="Category"></label>
    <select asp-for="Category" asp-items="@(new SelectList(Product.Categories))"
            style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;">
    </select>
    <span asp-validation-for="Category" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="3" placeholder="What does the bouquet include?"></textarea>
    <span asp-validation-for="Description" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="0.01" min="1" />
    <span asp-validation-for="Price" class="field-error"></span>
</div>

<div class="form-group">
    <label asp-for="ImageUrl"></label>
    <input asp-for="ImageUrl" placeholder="/images/flower.jpg" />
    <span class="hint">Optional. Put the picture inside wwwroot/images and write its path, e.g. /images/flower2.png</span>
    <span asp-validation-for="ImageUrl" class="field-error"></span>
</div>
