@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <!-- Embedded CSS for the image slider -->
    <style>
        .slider {
            position: relative;
            max-width: 900px;
            height: 380px;
            margin: 30px auto;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
            background-color: #fff0f6;
        }

        .slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 0.8s ease;
        }

        .slide.active {
            opacity: 1;
            z-index: 1;
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .slide-text {
            background: linear-gradient(135deg, #f8bbd0, #d63384);
        }

        .slide-caption {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 25px;
            color: white;
            text-align: center;
            background: linear-gradient(transparent, rgba(0,0,0,0.6));
        }

        .slide-text .slide-caption {
            top: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: none;
        }

        .slide-caption h2 {
            margin: 0 0 8px;
            font-size: 28px;
        }

        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: rgba(255,255,255,0.8);
            color: #d63384;
            font-size: 20px;
            cursor: pointer;
        }

        .slider-btn:hover {
            background-color: white;
        }

        .slider-btn.prev {
            left: 15px;
        }

        .slider-btn.next {
            right: 15px;
        }

        .slider-dots {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex;
            gap: 8px;
        }

        .slider-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid white;
            background: transparent;
            cursor: pointer;
            padding: 0;
        }

        .slider-dot.active {
            background-color: white;
        }
    </style>
}

<!-- Start of Hero Section -->
<section class="hero">
    <h1>Welcome to Flower & Gift Store</h1>
    <p>Make your loved ones' day brighter with our best flower bouquets</p>

    <!-- Internal Link Requirement within content -->
    <a href="#about-section" class="btn">Learn More About Us</a>
</section>
<!-- End of Hero Section -->

<!-- Image Slider (JavaScript dynamic element - see wwwroot/js/slider.js) -->
<section class="slider" id="homeSlider">
    <div class="slide active">
        <img src="~/images/flower.jpg" alt="Fresh red roses" />
        <div class="slide-caption">
            <h2>Fresh Red Roses 🌹</h2>
            <p>Hand-picked every morning for your special moments</p>
        </div>
    </div>

    <div class="slide">
        <img src="~/images/flower2.png" alt="Flowers with chocolate" />
        <div class="slide-caption">
            <h2>Flowers & Chocolate 🍫</h2>
            <p>The perfect gift box for someone you love</p>
        </div>
    </div>

    <div class="slide slide-text">
        <div class="slide-caption">
            <h2>🚚 Same-Day Delivery</h2>
            <p>Order before 4 PM and we deliver today</p>
            <p><a asp-controller="Products" asp-action="Index" class="btn">Shop Now</a></p>
        </div>
    </div>

    <button type="button" class="slider-btn prev" aria-label="Previous slide">❮</button>
    <button type="button" class="slider-btn next" aria-label="Next slide">❯</button>
    <div class="slider-dots"></div>
</section>

@if (TempData["Message"] != null)
{
    <div style="max-width: 600px; margin: 20px auto; padding: 12px; background-color: #fff0f6; border: 1px solid #f5c2d7; border-radius: 8px; color: #d63384; text-align: center; font-weight: bold;">
        @TempData["Message"]
    </div>
}

<!-- Image Mapping Section -->
<div class="hero-image-container">
    <h3>Click anywhere on the image below to visit "About Us" page</h3>

    <img src="~/images/flower.jpg"
         alt="Flower Store"
         usemap="#workmap"
         width="400"
         style="border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">

    <map name="workmap">
        <area shape="rect"
              coords="0,0,400,400"
              alt="About Us"
              href="@Url.Action("About", "Home")">
    </map>
</div>

<!-- Start of Featured Products Section (products come from the database) -->
<section class="featured-products" id="products-info">
    <h2>Featured Products</h2>

    <!-- List Requirement -->
    <ul class="features-list">
        <li>✨ 100% Fresh & Guaranteed Quality Flowers</li>
        <li>🚚 Fast Same-Day Delivery</li>
        <li>🎁 Premium Gift Packaging</li>
    </ul>

    <!-- Table Requirement -->
    <table>
        <thead>
            <tr>
                <th>Bouquet Name</th>
                <th>Includes</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("0.##") SAR</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Product Cards -->
    <div class="product-grid">
        @foreach (var product in Model)
        {
            <div class="product-card"
                 data-name="@product.Name"
                 data-price="@product.Price">

                <h3>@product.Name</h3>
                <p>@product.Price.ToString("0.##") SAR</p>

                <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart-form">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Home")" />
                    <button type="submit" class="btn add-to-cart">
                        Add to Cart
                    </button>
                </form>
            </div>
        }
    </div>

    <p style="text-align: center;">
        <a asp-controller="Products" asp-action="Index" class="btn">View All Products 🌸</a>
    </p>
</section>
<!-- End of Featured Products Section -->

<!-- Article Element and Internal Linking Target -->
<article id="about-section"
         style="text-align: center; padding: 40px; background-color: #fff; margin: 20px 0;">

    <h2>Why Choose Our Store?</h2>

    <p>
        We provide the finest flower arrangements and custom gifts
        to make all your special occasions unforgettable.
    </p>
</article>

@section Scripts {
    <!-- External JavaScript for the slider -->
    <script src="~/js/slider.js" asp-append-version="true"></script>

    <!-- Embedded JavaScript -->
    <script>
        // Display a welcome message in the browser console
        console.log("Welcome to Flower & Gift Store!");
    </script>
}
