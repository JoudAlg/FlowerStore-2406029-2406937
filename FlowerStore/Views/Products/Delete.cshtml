@model Product
@{
    ViewData["Title"] = "Delete Product";
}

@section Styles {
    <style>
        .form-container {
            max-width: 500px;
            margin: 40px auto;
            padding: 30px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-family: inherit;
        }

        .field-error {
            color: #dc3545;
            font-size: 13px;
        }

        .hint {
            color: #888;
            font-size: 12px;
        }
    </style>
}

<div class="form-container">
    <h2 style="color: #dc3545;">Delete Product 🗑️</h2>
    <p>Are you sure you want to delete this product?</p>

    <table style="margin: 20px auto;">
        <tr><th>Name</th><td>@Model.Name</td></tr>
        <tr><th>Description</th><td>@Model.Description</td></tr>
        <tr><th>Price</th><td>@Model.Price.ToString("0.##") SAR</td></tr>
    </table>

    <!-- DELETE form: sends the request to ProductsController.Delete (POST) -->
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn" style="background-color: #dc3545;">Yes, Delete</button>
        <a asp-action="Manage" class="btn">Cancel</a>
    </form>
</div>
