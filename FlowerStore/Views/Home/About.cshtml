@{
    ViewData["Title"] = "About Us";
}

@section Styles {
    <!-- Embedded CSS for About Us Content -->
    <style>
        .about-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 40px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .about-container h2 {
            color: #d63384;
            margin-bottom: 20px;
        }

        .about-container p {
            line-height: 1.6;
            color: #555;
            font-size: 16px;
            margin-bottom: 15px;
        }
    </style>
}

<!-- About Us Content Container -->
<div class="about-container">
    <h2 style="color: #d63384;">About Our Flower Store</h2>
    <p>Welcome to <strong>Flower Store</strong>, your number one destination for fresh, beautiful floral arrangements and premium gifts. We are dedicated to providing you the very best of bouquets, with a focus on quality, fast same-day delivery, and exquisite packaging.</p>
    <p>Founded with a passion for spreading joy and making your loved ones' days brighter, our store brings nature's finest blooms right to your doorstep. Whether it's a birthday, anniversary, or any special occasion, we are here to help you express your feelings through flowers.</p>
    <p>Thank you for choosing us to be a part of your special moments!</p>
</div>

<!-- Image Mapping Section -->
<div style="text-align: center; margin: 30px 0;">
    <img src="~/flower.jpg" alt="Flower Store" usemap="#workmap" width="250" style="border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <map name="workmap">
        <area shape="rect" coords="0,0,250,250" alt="About Us" href="@Url.Action("About", "Home")">
    </map>
</div>
