@model Product
@{
    ViewData["Title"] = "Edit Product";
}

@section Styles {
    <style>
        .form-container {
            max-width: 500px;
            margin: 40px auto;
            padding: 30px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #333;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-family: inherit;
        }

        .field-error {
            color: #dc3545;
            font-size: 13px;
        }

        .hint {
            color: #888;
            font-size: 12px;
        }
    </style>
}

<div class="form-container">
    <h2 style="color: #d63384;">Edit Product ✏️</h2>

    <!-- UPDATE form: sends the changes to ProductsController.Edit (POST) -->
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="productForm">
        <input type="hidden" asp-for="Id" />
        <partial name="_ProductForm" model="Model" />

        <button type="submit" class="btn" style="width: 100%;">Save Changes</button>
    </form>

    <p style="margin-top: 15px;">
        <a asp-action="Manage" style="color: #d63384;">← Back to Manage Products</a>
    </p>
</div>
