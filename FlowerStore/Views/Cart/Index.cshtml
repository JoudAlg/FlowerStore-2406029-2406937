@{
    ViewData["Title"] = "Shopping Cart";
}

@section Styles {
    <style>
        .cart-container {
            max-width: 850px;
            margin: 40px auto;
            padding: 35px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
        }

        .cart-container h1 {
            color: #d63384;
        }

        .cart-item {
            padding: 15px;
            margin: 10px 0;
            background-color: #fff0f6;
            border: 1px solid #f5c2d7;
            border-radius: 8px;
        }

        .cart-total {
            color: #d63384;
            margin-top: 25px;
        }

        #cart-items {
            list-style: none;
            padding: 0;
        }
    </style>
}

<!-- Shopping Cart -->
<!-- Student 1: this cart still uses localStorage (script.js); it will move to the Session -->
<main class="cart-container">
    <h1>🛒 Your Shopping Cart</h1>
    <p>Here are the flowers you selected.</p>

    <ul id="cart-items">
        <li>Your cart is empty.</li>
    </ul>

    <h2 class="cart-total">
        Total: <span id="cart-total">0</span> SAR
    </h2>

    <button class="btn" id="clearCartBtn" type="button">
        Clear Cart
    </button>

    <p>
        <a asp-controller="Products" asp-action="Index" class="btn">
            Continue Shopping 🌸
        </a>
    </p>
</main>

<!-- Image Mapping -->
<div style="text-align:center; margin:30px 0;">
    <h3>Click the image to visit About Us</h3>
    <img src="~/flower.jpg"
         alt="Flower Store"
         width="250"
         usemap="#workmap"
         style="border-radius:8px; box-shadow:0 4px 8px rgba(0,0,0,0.1);">
    <map name="workmap">
        <area shape="rect"
              coords="0,0,250,250"
              alt="About Us"
              href="@Url.Action("About", "Home")">
    </map>
</div>
