
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flower Store - @ViewData["Title"]</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <!-- Each page can add its own embedded CSS here -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    
    <!-- Start of Header and Navigation Bar -->
    @{
        var isLoggedIn = Context.Session.GetInt32("UserId").HasValue;
        var isAdmin = Context.Session.GetString("UserRole") == "Admin";
        var fullName = Context.Session.GetString("UserName") ?? "";
        var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    }
    <header class="main-header">
        <a asp-controller="Home" asp-action="Index" class="logo">🌸 Flower Store</a>

        <nav class="nav-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <a asp-controller="Cart" asp-action="Index">🛒 Cart</a>
            <a asp-controller="Home" asp-action="About">About Us</a>

            @if (isLoggedIn)
            {
                <a asp-controller="Orders" asp-action="MyOrders">📦 My Orders</a>

                if (isAdmin)
                {
                    <a asp-controller="Products" asp-action="Manage">⚙️ Manage</a>
                }

                <span class="nav-user" title="@fullName">Hi, @firstName 👋</span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register" class="nav-signup">Sign-up</a>
            }
        </nav>
    </header>
    <!-- End of Header -->
    @RenderBody()

    <!-- Start of Footer -->
    <footer>
        <p>All Rights Reserved &copy; 2026</p>
    </footer>
    <!-- End of Footer -->
    <!-- External JavaScript -->
    <script src="~/js/script.js" asp-append-version="true"></script>

    <!-- Each page can add its own embedded JavaScript here -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
